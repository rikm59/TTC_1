# ═══════════════════════════════════════════════════════════════
# XPERT LIFE SOLUTIONS — AI Agent Team Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in REAL values.
# Never commit .env — it is in .gitignore.
# ═══════════════════════════════════════════════════════════════

# ── SECURITY ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
TRIGGER_SECRET_KEY=change-this-to-a-strong-random-secret

# ── SERVER ───────────────────────────────────────────────────
PORT=3000
RUN_ON_STARTUP=false        # Set to true to run full sequence on server start

# ── OWNER INFO ───────────────────────────────────────────────
OWNER_NAME=Rick
OWNER_PHONE_NUMBER=+1XXXXXXXXXX    # Your mobile (gets hot lead alerts)
OWNER_EMAIL=rick@xpertlifesolutions.com

# ── ANTHROPIC (CLAUDE AI) ────────────────────────────────────
# Get from: https://console.anthropic.com/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── ELEVENLABS (JARVIS VOICE) ─────────────────────────────────
# Get from: https://elevenlabs.io/app/settings/api-keys
# Voice ID: search "JARVIS" in ElevenLabs voice library
# Default below is "Daniel" — a crisp British male voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# ── FISH AUDIO (JARVIS VOICE — alternative) ───────────────────
# Get from: https://fish.audio/go-api/
# Find JARVIS model ID by searching "JARVIS" at fish.audio/m/
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID=

# ── TTS PROVIDER ──────────────────────────────────────────────
# Which service speaks for JARVIS: elevenlabs | fish | browser
# Falls back to browser Web Speech if key is missing
TTS_PROVIDER=elevenlabs

# ── NOTION (CRM & Content Calendar) ─────────────────────────
# Create integration at: https://www.notion.so/profile/integrations
# Share ALL databases below with your integration
NOTION_API_KEY=secret_...
NOTION_PARENT_PAGE_ID=           # Parent page ID for setup-notion.js

# ✅ ALREADY CREATED — databases live in your Notion workspace under
#    "⚡ Xpert Life Solutions — AI Command Center"
NOTION_LEADS_DATABASE_ID=f02e7e6a-e218-450b-bcee-1ada8dc4bd58
NOTION_CONTENT_DATABASE_ID=110a4ce2-a527-4034-8c46-ccea715adfbd
NOTION_APPOINTMENTS_DATABASE_ID=01ea4393-d071-4da8-b2a5-ce334d7add2d
NOTION_FOLLOWUP_DATABASE_ID=42313984-99d9-4fde-9621-6032fe0df352

# ── TWILIO (SMS) ─────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX    # Your Twilio number

# ── SENDGRID (EMAIL) ─────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG...
FROM_EMAIL=rick@xpertlifesolutions.com
FROM_NAME=Rick @ Xpert Life Solutions

# ── FACEBOOK / INSTAGRAM ─────────────────────────────────────
# From: https://developers.facebook.com/tools/explorer
# Permissions: instagram_basic, pages_show_list, pages_read_engagement,
#              leads_retrieval, ads_read
INSTAGRAM_ACCESS_TOKEN=your-facebook-graph-api-token
FB_APP_ID=your-app-id
FB_APP_SECRET=your-app-secret

# Facebook Lead Ads — comma-separated form IDs from your Ad campaigns
# Find in Ads Manager → Leads Center → Lead Ad Forms
FACEBOOK_LEAD_FORM_IDS=form-id-1,form-id-2

# Facebook webhook verification token (you choose this — put it in Facebook dev console too)
FACEBOOK_WEBHOOK_VERIFY_TOKEN=my-webhook-verify-token

# ── SCHEDULING ───────────────────────────────────────────────
# Your Calendly booking link (or any scheduling link)
BOOKING_LINK=https://calendly.com/your-username/15min

# ── EXISTING NOTION (INSTAGRAM SYNC — Legacy) ────────────────
# Keep these if you still use the Instagram → Notion sync feature
NOTION_DATABASE_ID=
NOTION_ACCOUNTS_DATABASE_ID=
