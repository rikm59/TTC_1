# ============================================================
# TexTop Choice Multi-Agent Framework — Environment Vars
# ============================================================
# Agents:
#   1. Instagram Saves → Notion (engine.js)
#   2. TikTok Growth Agent → 18k followers (tiktok-growth-agent.js)
#
# Copy this file to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.
# Add all vars under the Environment tab in your Render dashboard.
# ============================================================

# ----------------------------------------------------------
# REQUIRED — Webhook authentication
# Generate: openssl rand -hex 32
# ----------------------------------------------------------
TRIGGER_SECRET_KEY=CreateYourOwnComplexSecretPassphraseHere

# ----------------------------------------------------------
# OPTIONAL — HTTP port (Render injects PORT automatically)
# ----------------------------------------------------------
# PORT=3000

# ============================================================
# TIKTOK GROWTH AGENT
# ============================================================

# ----------------------------------------------------------
# Anthropic / Claude API — powers content generation,
# script writing, and hashtag strategy
# Get your key at: https://console.anthropic.com/
# ----------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ----------------------------------------------------------
# Notion — TikTok Content Calendar database
# Required properties (exact names and types):
#   Name          → Title
#   Day           → Select  (Mon/Tue/Wed/Thu/Fri/Sat/Sun)
#   Week          → Text
#   Content Type  → Select
#   Hook          → Text
#   Script        → Text
#   Hashtags      → Text
#   Posting Time  → Text
#   Growth Tip    → Text
#   Status        → Select  (Idea / Script Ready / Filmed / Posted / Strategy)
# ----------------------------------------------------------
NOTION_TIKTOK_CONTENT_DATABASE_ID=your-tiktok-content-database-id-here

# ----------------------------------------------------------
# Notion — TikTok Follower Tracker database
# Required properties (exact names and types):
#   Name               → Title
#   Follower Count     → Number
#   Goal               → Number
#   Progress %         → Number
#   Remaining to Goal  → Number
#   Date               → Date
#   Weekly Growth      → Number
#   Notes              → Text
# ----------------------------------------------------------
NOTION_TIKTOK_TRACKER_DATABASE_ID=your-tiktok-tracker-database-id-here

# ============================================================
# INSTAGRAM SYNC AGENT
# ============================================================

# ----------------------------------------------------------
# Instagram Graph API (via graph.facebook.com)
# 1. Go to: https://developers.facebook.com/tools/explorer
# 2. Select your App, click "Generate Access Token"
# 3. Required permissions: instagram_basic, pages_show_list,
#    pages_read_engagement, instagram_manage_insights
# ----------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your-facebook-graph-api-token-here

# ----------------------------------------------------------
# Optional — Auto token refresh (strongly recommended)
# Paste App ID and App Secret from:
#   developers.facebook.com → Your App → App Settings → Basic
# ----------------------------------------------------------
FB_APP_ID=your-app-id-here
FB_APP_SECRET=your-app-secret-here

# ----------------------------------------------------------
# Notion — Instagram integration
# Share both databases with your Notion integration
# ----------------------------------------------------------
NOTION_API_KEY=secret_your-notion-integration-token-here

# "Instagram Posts" database ID
NOTION_DATABASE_ID=a9e63dc8-16a6-4cf7-8554-7dc7cfcde933

# "Instagram Accounts" database ID
NOTION_ACCOUNTS_DATABASE_ID=dbb3afce-fede-4849-8006-9c4e31d129f0

# ----------------------------------------------------------
# "Instagram Posts" database required properties:
#   Name        → Title
#   Post URL    → URL
#   Caption     → Text
#   Author      → Text
#   Thumbnail   → URL
#   Posted At   → Date
# ----------------------------------------------------------
